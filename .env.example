# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spotify_sync_rooms?schema=public"

# Redis (Room State & Socket.IO Pub/Sub Adapter)
REDIS_URL="redis://localhost:6379"

# Security & Sessions
JWT_SECRET="super-secret-production-jwt-key-replace-in-production"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="*"

# Room & Sync Settings
MAX_ROOM_MEMBERS=50
ROOM_IDLE_TTL=1800
SYNC_INTERVAL_MS=5000
SCHEDULE_BUFFER_MS=1500

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
